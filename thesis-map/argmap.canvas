      "x": 20,
      "y": 22,
      "width": 400,
      "height": 44,
      "text": "**x\u1d52 / x\u1d9c Distinction**\ntwo modes of one word",
      "kind": "notation-primary",
      "color": "2"
    },
    {
      "id": "xo",
      "type": "text",
      "x": 20,
      "y": 76,
      "width": 125,
      "height": 34,
      "text": "**x\u1d52 \u2014 object-mode**\n\"this x here\"",
      "kind": "notation-secondary",
      "color": "2"
    },
    {
      "id": "R",
      "type": "text",
      "x": 158,
      "y": 76,
      "width": 125,
      "height": 34,
      "text": "**\ud835\udce1 \u2014 grounding op**\n\u27e8x\u27e9 \u2194 E({X})",
      "kind": "notation-secondary",
      "color": "2"
    },
    {
      "id": "xc",
      "type": "text",
      "x": 295,
      "y": 76,
      "width": 125,
      "height": 34,
      "text": "**x\u1d9c \u2014 concept-mode**\n\"the x\", \"x is...\"",
      "kind": "notation-secondary",
      "color": "2"
    },
    {
      "id": "zone-framing",
      "type": "text",
      "x": 20,
