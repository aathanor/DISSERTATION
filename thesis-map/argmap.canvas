    },
    {
      "id": "russell",
      "type": "text",
      "x": 10,
      "y": 290,
      "width": 110,
      "height": 44,
      "text": "**Russell**\nfound, then restricted",
      "kind": "thinker",
      "color": "5",
      "shape": "ellipse"
    },
    {
      "id": "kripke",
      "type": "text",
      "x": 165,
      "y": 290,
      "width": 110,
      "height": 44,
      "text": "**Kripke**\nextended, didn't supply",
      "kind": "thinker",
      "color": "5",
      "shape": "ellipse"
    },
    {
      "id": "pru",
      "type": "text",
      "x": 320,
