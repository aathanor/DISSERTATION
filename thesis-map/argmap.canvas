{
  "nodes": [
    {
      "id": "zone-foundations",
      "type": "text",
      "x": 20,
      "y": 0,
      "width": 260,
      "height": 14,
      "text": "PRU foundations",
      "role": "label"
    },
    {
      "id": "xo-xc",
      "type": "text",
      "x": 20,
      "y": 18,
      "width": 400,
      "height": 44,
      "text": "**x\u1d52 / x\u1d9c Distinction**\ntwo modes of one word",
      "kind": "foundations-primary",
      "color": "5"
    },
    {
      "id": "xo",
      "type": "text",
      "x": 20,
      "y": 66,
      "width": 125,
      "height": 34,
      "text": "**x\u1d52 \u2014 object-mode**\n\"this x here\"",
      "kind": "foundations",
      "color": "5"
    },
    {
      "id": "R",
      "type": "text",
      "x": 158,
      "y": 66,
      "width": 125,
      "height": 34,
      "text": "**\ud835\udce1 \u2014 grounding op**\n\u27e8x\u27e9 \u2194 E({X})",
      "kind": "foundations",
      "color": "5"
    },
    {
      "id": "xc",
      "type": "text",
      "x": 295,
      "y": 66,
      "width": 125,
      "height": 34,
      "text": "**x\u1d9c \u2014 concept-mode**\n\"the x\", \"x is...\"",
      "kind": "foundations",
      "color": "5"
    },
    {
      "id": "zone-thesis",
      "type": "text",
      "x": 20,
      "y": 114,
      "width": 200,
      "height": 14,
      "text": "central thesis",
      "role": "label"
    },
    {
      "id": "thesis",
      "type": "text",
      "x": 20,
      "y": 132,
      "width": 400,
      "height": 60,
      "text": "**Language can locate, but not hold**\nRigid designation = social stabilization of x\u1d52 tracking",
      "kind": "thesis",
      "color": "4"
    },
    {
      "id": "zone-sota",
      "type": "text",
      "x": 20,
      "y": 206,
      "width": 200,
      "height": 14,
      "text": "SOTA and gap",
      "role": "label"
    },
    {
      "id": "russell",
      "type": "text",
      "x": 20,
      "y": 224,
      "width": 120,
      "height": 44,
      "text": "**Russell**\nfound, then restricted",
      "kind": "sota",
      "color": "4",
      "shape": "ellipse"
    },
    {
      "id": "kripke",
      "type": "text",
      "x": 160,
      "y": 224,
      "width": 120,
      "height": 44,
      "text": "**Kripke**\nextended, didn't supply",
      "kind": "sota",
      "color": "4",
      "shape": "ellipse"
    },
    {
      "id": "pru",
      "type": "text",
      "x": 300,
      "y": 224,
      "width": 120,
      "height": 44,
      "text": "**PRU**\nproposed mechanism",
      "kind": "sota",
      "color": "4",
      "shape": "ellipse"
    },
    {
      "id": "gap",
      "type": "text",
      "x": 120,
      "y": 276,
      "width": 200,
      "height": 34,
      "text": "**The Explanatory Gap**",
      "kind": "sota-gap",
      "color": "4",
      "dashed": true
    },
    {
      "id": "zone-argument",
      "type": "text",
      "x": 20,
      "y": 324,
      "width": 200,
      "height": 14,
      "text": "argument",
      "role": "label"
    },
    {
      "id": "line1",
      "type": "text",
      "x": 20,
      "y": 342,
      "width": 93,
      "height": 36,
      "text": "**1. Formula**\nextensional silence",
      "kind": "argument",
      "color": "1"
    },
    {
      "id": "line2",
      "type": "text",
      "x": 117,
      "y": 342,
      "width": 93,
      "height": 36,
      "text": "**2. Russell**\ndemonstratives",
      "kind": "argument",
      "color": "1"
    },
    {
      "id": "line3",
      "type": "text",
      "x": 214,
      "y": 342,
      "width": 93,
      "height": 36,
      "text": "**3. Descriptions**\nmodal failure",
      "kind": "argument",
      "color": "1"
    },
    {
      "id": "line6",
      "type": "text",
      "x": 311,
      "y": 342,
      "width": 93,
      "height": 36,
      "text": "**6. Baptism**\nlifting, not creation",
      "kind": "argument",
      "color": "1"
    },
    {
      "id": "local-rigidity",
      "type": "text",
      "x": 90,
      "y": 392,
      "width": 260,
      "height": 50,
      "text": "**Local Rigidity**\nthe primitive form of reference",
      "kind": "argument-hub",
      "color": "1"
    },
    {
      "id": "baptism",
      "type": "text",
      "x": 80,
      "y": 456,
      "width": 280,
      "height": 36,
      "text": "**Baptism as Lifting**\n\ud835\udce1(h\u1d52, N\u1d9c) \u2014 portable demonstratives",
      "kind": "argument-mechanism",
      "color": "1"
    },
    {
      "id": "line4",
      "type": "text",
      "x": 50,
      "y": 506,
      "width": 155,
      "height": 36,
      "text": "**De re modality**\ntreated in Ch 4 (\u00a74.3)",
      "kind": "argument-explained",
      "color": "1",
      "dashed": true
    },
    {
      "id": "line5",
      "type": "text",
      "x": 235,
      "y": 506,
      "width": 155,
      "height": 36,
      "text": "**Necessary a posteriori**\ntreated in Ch 5",
      "kind": "argument-explained",
      "color": "1",
      "dashed": true
    },
