      "color": "2"
    },
    {
      "id": "xc",
      "type": "text",
      "x": 295,
      "y": 66,
      "width": 125,
      "height": 34,
      "text": "**x\u1d9c \u2014 concept-mode**\n\"the x\", \"x is...\"",
