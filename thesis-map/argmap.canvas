    },
    {
      "id": "framing",
      "type": "text",
      "x": 20,
      "y": 132,
      "width": 400,
      "height": 44,
      "text": "**Language can locate, but not hold**\ncentral observation",
      "kind": "framing",
      "color": "3"
    },
    {
      "id": "thesis",
      "type": "text",
      "x": 20,
      "y": 180,
      "width": 400,
      "height": 48,
      "text": "**Central Thesis**\nRigid designation = social stabilization of x\u1d52 tracking",
      "kind": "thesis",
      "color": "2"
    },
    {
      "id": "zone-positions",
      "type": "text",
