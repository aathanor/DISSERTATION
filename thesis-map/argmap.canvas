      "color": "1"
    },
    {
      "id": "line4",
      "type": "text",
      "x": 20,
      "y": 472,
      "width": 125,
      "height": 32,
      "text": "**4. De re**\npayoff, not support",
      "kind": "explained",
      "color": "4",
      "dashed": true
    },
    {
      "id": "line5",
      "type": "text",
      "x": 158,
      "y": 472,
      "width": 125,
      "height": 32,
      "text": "**5. Nec. a posteriori**\npayoff, not support",
      "kind": "explained",
      "color": "4",
      "dashed": true
    },
    {
      "id": "line6",
      "type": "text",
      "x": 295,
      "y": 472,
      "width": 125,
      "height": 32,
      "text": "**6. Baptism**\nlifting, not creation",
      "kind": "support",
      "color": "4"
    },
